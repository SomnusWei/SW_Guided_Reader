# Development/testing overrides only. The normal product path reads API keys
# from the fixed Windows Credential Manager targets shown below.
#
# Supported providers (registry presets in
# src/reader_service/agent_runtime/registry.py):
#   deepseek / zhipu / openrouter / qwen / moonshot / doubao / minimax /
#   spark / hunyuan / siliconflow / custom
# Each provider uses the same GUIDED_READER_{PROVIDER}_* variables
# (API_KEY, DISABLED, ENDPOINT, MODEL, TEMPERATURE, MAX_TOKENS,
# TIMEOUT_SECONDS) and the Credential Manager target
# 408-guided-reader-{provider}.
#
# custom has empty endpoint/model defaults; fill both in, e.g.:
#   GUIDED_READER_CUSTOM_ENDPOINT=https://your-gateway.example/v1/chat/completions
#   GUIDED_READER_CUSTOM_MODEL=your-model
# doubao requires the Volcano Ark endpoint id (ep-xxx) as the model.

GUIDED_READER_ASSISTANT_PROVIDER=deepseek
GUIDED_READER_MASTER_PROVIDER=deepseek
# Review uses this exact configured route; there is no silent provider fallback.
GUIDED_READER_REVIEW_PROVIDER=zhipu
GUIDED_READER_PROVIDER_BAKEOFF=0

# Section Guide generation provider; explicit provider/model overrides remain
# authoritative. Review stays a separate fresh-context call via
# GUIDED_READER_REVIEW_PROVIDER.
GUIDED_READER_SYSTEM_PROVIDER=deepseek

# Credential target: 408-guided-reader-deepseek
GUIDED_READER_DEEPSEEK_API_KEY=
GUIDED_READER_DEEPSEEK_DISABLED=0
GUIDED_READER_DEEPSEEK_ENDPOINT=https://api.deepseek.com/chat/completions
# DeepSeek V4.1 Flash uses the official API alias deepseek-flash.
GUIDED_READER_DEEPSEEK_MODEL=deepseek-flash
GUIDED_READER_DEEPSEEK_TEMPERATURE=0.2
GUIDED_READER_DEEPSEEK_MAX_TOKENS=4096
GUIDED_READER_DEEPSEEK_TIMEOUT_SECONDS=120

# Credential target: 408-guided-reader-zhipu
GUIDED_READER_ZHIPU_API_KEY=
GUIDED_READER_ZHIPU_DISABLED=0
GUIDED_READER_ZHIPU_ENDPOINT=https://open.bigmodel.cn/api/paas/v4/chat/completions
GUIDED_READER_ZHIPU_MODEL=GLM-5.3-Flash
GUIDED_READER_ZHIPU_TEMPERATURE=0.2
GUIDED_READER_ZHIPU_MAX_TOKENS=4096
GUIDED_READER_ZHIPU_TIMEOUT_SECONDS=120

# Credential target: 408-guided-reader-qwen (Alibaba DashScope OpenAI-compatible mode)
GUIDED_READER_QWEN_API_KEY=
GUIDED_READER_QWEN_DISABLED=0
GUIDED_READER_QWEN_ENDPOINT=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
GUIDED_READER_QWEN_MODEL=qwen-plus
GUIDED_READER_QWEN_TEMPERATURE=0.2
GUIDED_READER_QWEN_MAX_TOKENS=4096
GUIDED_READER_QWEN_TIMEOUT_SECONDS=120

# OpenRouter remains available. Its proxy is optional: when the override below
# (or the enabled Windows current-user proxy) is present, calls use it strictly;
# otherwise they go direct. There is no model whitelist.
GUIDED_READER_OPENROUTER_API_KEY=
GUIDED_READER_OPENROUTER_DISABLED=0
GUIDED_READER_OPENROUTER_ENDPOINT=https://openrouter.ai/api/v1/chat/completions
GUIDED_READER_OPENROUTER_MODEL=google/gemini-3.8-flash
GUIDED_READER_OPENROUTER_PROXY=
GUIDED_READER_OPENROUTER_TEMPERATURE=0.2
GUIDED_READER_OPENROUTER_MAX_TOKENS=900
GUIDED_READER_OPENROUTER_TIMEOUT_SECONDS=45

# Reading Guide author/formatter only; independent Review/Assistant keep their models.
GUIDED_READER_GUIDE_MODEL=

# Direct Inline Teaching generator only; independent Review uses its existing route.
GUIDED_READER_INLINE_MODEL=

# OCR backend: external locally installed Umi-OCR HTTP service.
# Pages fail with OCR_UNAVAILABLE (retryable) when the service is not running.
GUIDED_READER_UMI_OCR_ENDPOINT=http://127.0.0.1:1224
GUIDED_READER_UMI_OCR_DISABLED=0
# Empty follows Umi-OCR's own default language; e.g. en, zh_ch.
GUIDED_READER_UMI_OCR_LANGUAGE=
GUIDED_READER_UMI_OCR_TIMEOUT_SECONDS=120
